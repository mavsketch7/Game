# Copia este archivo a .env.local (git lo ignora) para desarrollo local.
#
# Con placeholders (como vienen aquí) el juego arranca y se puede jugar/
# probar en local con normalidad -- lo único que no funcionará es lo que
# de verdad hable con Supabase (gremios, rankings online...). Sin ESTE
# archivo (o sin .env.local), el cliente de Supabase revienta al cargar
# la página (ver src/net/supabaseClient.js) y el juego ni siquiera llega
# al menú.
#
# Para conectar con un proyecto Supabase real, sustituye estos valores
# por los de tu proyecto (Project Settings -> API).
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key-for-local-testing
